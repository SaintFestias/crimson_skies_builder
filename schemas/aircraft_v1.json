{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/aircraft/v1.json",
  "title": "Aircraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "name", "class", "propulsion", "manufacturer", "engines", "dimensions", "performance", "weapons", "armor", "game_stats", "source", "visibility", "version"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "class": { "enum": ["Fighter", "Heavy Fighter"] },
    "propulsion": { "enum": ["Tractor", "Pusher"] },
    "manufacturer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "count", "hp_each"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "hp_each": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wingspan_in", "length_in", "height_in", "length_excludes_prop"],
      "properties": {
        "wingspan_in": { "type": "integer", "minimum": 1 },
        "length_in": { "type": "integer", "minimum": 1 },
        "height_in": { "type": "integer", "minimum": 1 },
        "length_excludes_prop": { "type": "boolean" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaded_weight_lbs", "service_ceiling_ft", "range_miles", "max_speed_mph", "max_accel_ft_s", "max_decel_ft_s"],
      "properties": {
        "loaded_weight_lbs": { "type": "integer", "minimum": 1 },
        "service_ceiling_ft": { "type": "integer", "minimum": 0 },
        "range_miles": { "type": "integer", "minimum": 0 },
        "max_speed_mph": { "type": "integer", "minimum": 0 },
        "max_accel_ft_s": { "type": "number", "minimum": 0 },
        "max_decel_ft_s": { "type": "number", "minimum": 0 }
      }
    },
    "weapons": {
      "description": "One entry per physical weapon. The source's grouped counts are expanded.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "caliber", "type", "arc", "mass_lbs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "caliber": { "type": ["integer", "null"], "minimum": 1 },
          "type": { "enum": ["machine_gun", "cannon", "turret_mount"] },
          "arc": { "enum": ["Forward", "Nose", "Turret", "Rear Turret"] },
          "mass_lbs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "armor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locations", "total_points", "mass_lbs"],
      "properties": {
        "locations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nose", "port_wing_leading", "port_wing_trailing", "starboard_wing_leading", "starboard_wing_trailing", "tail"],
          "properties": {
            "nose": { "type": ["integer", "null"], "minimum": 0 },
            "port_wing_leading": { "type": ["integer", "null"], "minimum": 0 },
            "port_wing_trailing": { "type": ["integer", "null"], "minimum": 0 },
            "starboard_wing_leading": { "type": ["integer", "null"], "minimum": 0 },
            "starboard_wing_trailing": { "type": ["integer", "null"], "minimum": 0 },
            "tail": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "total_points": { "type": "integer", "minimum": 0 },
        "mass_lbs": { "type": "integer", "minimum": 0 }
      }
    },
    "game_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_target_number", "maximum_speed", "maximum_gs", "acceleration_rate"],
      "properties": {
        "base_target_number": { "$ref": "#/$defs/stat_required" },
        "maximum_speed": { "$ref": "#/$defs/stat_nullable" },
        "maximum_gs": { "$ref": "#/$defs/stat_required" },
        "acceleration_rate": { "$ref": "#/$defs/stat_required" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "edition": { "type": ["string", "null"] }
      }
    },
    "visibility": { "enum": ["default", "private", "shared"] },
    "owner_id": { "type": ["string", "null"] },
    "version": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "stat_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "mass_lbs"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "mass_lbs": { "type": "integer", "minimum": 0 }
      }
    },
    "stat_nullable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "mass_lbs"],
      "properties": {
        "value": { "type": ["integer", "null"], "minimum": 0 },
        "mass_lbs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
